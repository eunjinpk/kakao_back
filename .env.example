PORT=8000

# W1 후반부터 사용
DATABASE_URL=sqlite:///./safeq.db
JWT_SECRET=change-me-in-local-env

# ── 음성 트랙 (개발자 B) ─────────────────────────────────────────
# clova = CLOVA Speech 실시간 스트리밍 / mock = 키 없이 개발 (샘플 문장 출력)
STT_PROVIDER=mock
CLOVA_SECRET_KEY=
CLOVA_HOST=clovaspeech-gw.ncloud.com:50051
CLOVA_LANGUAGE=ko
CLOVA_GAP_THRESHOLD_MS=600
CLOVA_DURATION_THRESHOLD_MS=6000
STT_IDLE_TIMEOUT_SEC=30

# openai = GPT-4o-mini / mock = 키워드 규칙
LLM_PROVIDER=mock
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SEC=5

# 텍스트 버퍼(초) · 같은 intent 재추천 금지 시간(초)
BUFFER_WINDOW_SEC=10
SUGGEST_COOLDOWN_SEC=30

# 공연 녹음 금지: 로컬 디버깅 때만 true (tmp/recordings/*.wav)
DEBUG_SAVE_AUDIO=false
